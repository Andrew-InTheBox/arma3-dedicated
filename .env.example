# Copy this file to .env and fill in machine-specific values.
# .env is git-ignored. .env.example is committed.

# SteamCMD path (override if not at default C:\steamcmd\steamcmd.exe)
# STEAMCMD=C:\steamcmd\steamcmd.exe

# Set to 1 to use SteamCMD to update workshop mods (required on public server)
# Set to 0 to copy from local Steam workshop cache (suitable for dev PC)
# USE_STEAMCMD=0

# Steam credentials for SteamCMD mod downloads (public server only)
# Anonymous login works for the server binary (app 233780), but workshop mods
# for app 107410 require an account that owns Arma 3.
# USERNAME=your_steam_username
# PASSWORD=your_steam_password

# Workshop cache path (where Steam installs Arma 3 workshop mods)
# WORKSHOP_PATH=E:\SteamLibrary\steamapps\workshop\content\107410

# Mod IDs to skip updating (space-separated Workshop IDs)
# SKIP_MOD_IDS=

# Mod folder names to skip updating (space-separated)
# SKIP_MODS=

# Set to 0 to skip mod updates entirely on restart
# ENABLE_WORKSHOP_UPDATES=1

# Set to 0 to update mods once then stop auto-updating on subsequent restarts
# UPDATE_ON_RESTART=1
